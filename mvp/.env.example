# HeadQuoter SpaceCraft — MVP (Fala 5) — przyklad konfiguracji.
# Skopiuj do .env i uzupelnij realnymi wartosciami:  cp .env.example .env
# UWAGA: .env NIE commituj. Zmien wszystkie "changeme_*" przed jakimkolwiek wystawieniem poza localhost.

# --- Ogolne ---
TZ=Europe/Warsaw

# --- Gitea (SVN/git self-host) ---
GITEA_HTTP_PORT=3000
GITEA_SSH_PORT=2222
GITEA_ROOT_URL=http://localhost:3000/
GITEA_DB_NAME=gitea
GITEA_DB_USER=gitea
GITEA_DB_PASSWORD=changeme_gitea_db

# --- n8n (automatyzacja) ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme_n8n
# Klucz szyfrowania credentiali n8n (min. 10 znakow). Wygeneruj np.: openssl rand -hex 24
N8N_ENCRYPTION_KEY=changeme_n8n_encryption_key_min_10chars

# --- Ollama (LLM self-host) ---
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=5m
